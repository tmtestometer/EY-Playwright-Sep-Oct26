{
  "name": "merv-client-cucumber",
  "version": "4.0.25",
  "description": "MERV Cucumber-js formatter — depends on merv-client core.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./formatter": {
      "types": "./dist/cucumber-entry.d.ts",
      "import": "./dist/cucumber-entry.js",
      "require": "./dist/cucumber-entry.cjs"
    },
    "./doctor": {
      "types": "./dist/doctor-entry.d.ts",
      "import": "./dist/doctor-entry.js",
      "require": "./dist/doctor-entry.cjs"
    }
  },
  "bin": {
    "merv-client-cucumber": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "merv",
    "cucumber",
    "cucumber-js",
    "gherkin",
    "test-reporting"
  ],
  "author": "TechElliptica",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/techelliiptica/merv.git",
    "directory": "merv-client-cucumber"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "merv-client": "^4.0.25"
  },
  "peerDependencies": {
    "@cucumber/cucumber": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@cucumber/cucumber": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cucumber-entry.ts src/doctor-entry.ts --format esm,cjs --dts --external merv-client --external merv-client/chai --external merv-client/doctor --external @cucumber/cucumber && npm run build:cli && tsc -p tsconfig.json --noEmit",
    "build:cli": "tsup --config tsup.cli.config.ts && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  }
}
