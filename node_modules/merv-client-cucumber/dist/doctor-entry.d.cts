/**
 * Doctor responsibility (same as Playwright):
 * 1. Wrong / incomplete MERV setup → correct it.
 * 2. cucumber.js / features layout → create or heal.
 * 3. Unrelated user settings → leave alone; only add MERV pieces.
 */
type DoctorAction = 'created' | 'updated' | 'skipped' | 'failed';
type DoctorStepResult = {
    step: string;
    action: DoctorAction;
    path?: string;
    detail?: string;
};
type CucumberDoctorOptions = {
    force?: boolean;
    language: 'javascript' | 'typescript';
};
/**
 * Cucumber-js MERV setup / heal.
 */
declare function setup(cwd: string, opts: CucumberDoctorOptions): DoctorStepResult[];

export { type CucumberDoctorOptions, type DoctorAction, type DoctorStepResult, setup };
