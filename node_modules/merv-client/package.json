{
  "name": "merv-client",
  "version": "4.0.25",
  "description": "MERV core client: local JSON/HTML reports, server sync, shared plugin steps, Chai — use merv-client-playwright / merv-client-cucumber for frameworks.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./playwright-test": {
      "types": "./dist/playwright-test.d.ts",
      "import": "./dist/playwright-test.js",
      "require": "./dist/playwright-test.cjs"
    },
    "./playwright-reporter": {
      "types": "./dist/playwright-reporter.d.ts",
      "import": "./dist/playwright-reporter.js",
      "require": "./dist/playwright-reporter.cjs"
    },
    "./reporter": {
      "types": "./dist/playwright-reporter.d.ts",
      "import": "./dist/playwright-reporter.js",
      "require": "./dist/playwright-reporter.cjs"
    },
    "./cucumber-formatter": {
      "types": "./dist/cucumber-formatter.d.ts",
      "import": "./dist/cucumber-formatter.js",
      "require": "./dist/cucumber-formatter.cjs"
    },
    "./chai": {
      "types": "./dist/chai-entry.d.ts",
      "import": "./dist/chai-entry.js",
      "require": "./dist/chai-entry.cjs"
    },
    "./doctor": {
      "types": "./dist/doctor-entry.d.ts",
      "import": "./dist/doctor-entry.js",
      "require": "./dist/doctor-entry.cjs"
    },
    "./browser": {
      "types": "./dist/browser-entry.d.ts",
      "import": "./dist/browser-entry.js",
      "require": "./dist/browser-entry.cjs"
    }
  },
  "bin": {
    "merv": "./dist/cli.js",
    "merv-client": "./dist/cli.js",
    "merv-doctor": "./dist/merv-doctor.js"
  },
  "files": [
    "dist",
    "public",
    "FRAMEWORK_INTEGRATION.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "merv",
    "techelliptica",
    "test-report",
    "test-reporting",
    "html-report",
    "json-report",
    "merv-local"
  ],
  "author": "TechElliptica",
  "license": "Apache-2.0",
  "homepage": "https://github.com/techelliiptica/merv/tree/main/merv-client-js#readme",
  "bugs": {
    "url": "https://github.com/techelliiptica/merv/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/techelliiptica/merv.git",
    "directory": "merv-client-js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0",
    "chai": ">=4.0.0",
    "merv-client-playwright": "4.0.25",
    "merv-client-cucumber": "4.0.25"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "chai": {
      "optional": true
    },
    "merv-client-playwright": {
      "optional": true
    },
    "merv-client-cucumber": {
      "optional": true
    }
  },
  "scripts": {
    "build:core": "tsup src/index.ts src/chai-entry.ts src/doctor-entry.ts src/browser-entry.ts --format esm,cjs --dts --external @playwright/test --external playwright/test --external chai --external merv-client-playwright --external merv-client-cucumber && npm run build:cli && tsc -p tsconfig.json --noEmit",
    "build:cli": "tsup --config tsup.cli.config.ts && node -e \"const fs=require('fs'); for (const f of ['dist/cli.js','dist/merv-doctor.js']) fs.chmodSync(f,0o755)\"",
    "build:compat": "tsup src/compat/playwright-reporter.ts src/compat/playwright-test.ts src/compat/cucumber-formatter.ts src/compat/framework.ts --format esm,cjs --dts --external merv-client-playwright --external merv-client-playwright/reporter --external merv-client-playwright/test --external merv-client-cucumber",
    "build": "npm run build:core && npm run build:compat",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "extract:index-dashboard": "python3 scripts/extract-index-livedashboard.py"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "optionalDependencies": {
    "merv-client-playwright": "^4.0.25",
    "merv-client-cucumber": "^4.0.25"
  }
}
