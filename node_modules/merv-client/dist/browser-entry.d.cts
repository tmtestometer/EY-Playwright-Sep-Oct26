/** Drop-in console for browser apps — mirrors to a shared Merv-Logs server via HTTP. */
type MervConsoleLike = {
    log: (...args: unknown[]) => void;
    info: (...args: unknown[]) => void;
    warn: (...args: unknown[]) => void;
    error: (...args: unknown[]) => void;
    debug: (...args: unknown[]) => void;
    trace: (...args: unknown[]) => void;
};
type MervBrowserConsoleOptions = {
    /** Base URL of the hub report server, e.g. `http://127.0.0.1:6174`. */
    logServer?: string;
    /** Project name shown on the shared Merv-Logs page ({@code merv.log.source}). */
    logSource?: string;
};
/**
 * Configure browser console forwarding. Reads {@code VITE_MERV_LOG_SERVER} /
 * {@code VITE_MERV_LOG_SOURCE} from Vite when options are omitted.
 */
declare function configureMervBrowserConsole(opts?: MervBrowserConsoleOptions): void;
/**
 * Browser-safe MERV console. Prints to DevTools and POSTs each line to the hub's
 * {@code /api/logs/ingest} endpoint when {@link configureMervBrowserConsole} or
 * {@code VITE_MERV_LOG_SERVER} is set.
 *
 * ```ts
 * import { console } from 'merv-client/browser';
 *
 * console.log('Login clicked', { userId });
 * ```
 */
declare const console: MervConsoleLike;

export { type MervBrowserConsoleOptions, type MervConsoleLike, configureMervBrowserConsole, console };
