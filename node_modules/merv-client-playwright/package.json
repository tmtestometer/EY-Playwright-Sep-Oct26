{
  "name": "merv-client-playwright",
  "version": "4.0.25",
  "description": "MERV Playwright reporter and test wrappers — depends on merv-client core.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./reporter": {
      "types": "./dist/reporter-entry.d.ts",
      "import": "./dist/reporter-entry.js",
      "require": "./dist/reporter-entry.cjs"
    },
    "./test": {
      "types": "./dist/playwright-test-shim.d.ts",
      "import": "./dist/playwright-test-shim.js",
      "require": "./dist/playwright-test-shim.cjs"
    },
    "./doctor": {
      "types": "./dist/doctor-entry.d.ts",
      "import": "./dist/doctor-entry.js",
      "require": "./dist/doctor-entry.cjs"
    }
  },
  "bin": {
    "merv-client-playwright": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "merv",
    "playwright",
    "playwright-test",
    "test-reporting",
    "html-report"
  ],
  "author": "TechElliptica",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/techelliiptica/merv.git",
    "directory": "merv-client-playwright"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "merv-client": "^4.0.25"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsup src/index.ts src/reporter-entry.ts src/playwright-test-shim.ts src/doctor-entry.ts --format esm,cjs --dts --external merv-client --external merv-client/chai --external merv-client/doctor --external ffmpeg-static --external @playwright/test --external playwright/test && npm run build:cli && tsc -p tsconfig.json --noEmit",
    "build:cli": "tsup --config tsup.cli.config.ts && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  }
}
